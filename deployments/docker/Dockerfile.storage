FROM golang:1.24-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/storage-node ./cmd/storage-node

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /bin/storage-node /usr/local/bin/storage-node

EXPOSE 50051 8081
VOLUME ["/data"]

ENTRYPOINT ["/usr/local/bin/storage-node"]
