# Vault Cluster Configuration

# Node identity (storage node)
VAULT_NODE_ID=storage-01
VAULT_DATA_DIR=./data/storage-01
VAULT_GRPC_ADDR=0.0.0.0:50051
VAULT_HTTP_PORT=8081

# Metadata Service
VAULT_METADATA_ADDR=localhost:50050
VAULT_METADATA_GRPC_ADDR=0.0.0.0:50050
VAULT_METADATA_HTTP_PORT=8080
VAULT_ETCD_ENDPOINTS=localhost:2379

# Coordinator
VAULT_COORDINATOR_GRPC_ADDR=0.0.0.0:50055
VAULT_COORDINATOR_HTTP_PORT=8085
VAULT_COORDINATOR_ADDR=localhost:50055

# Storage Cluster Nodes (for fixed placement in Phase 1)
VAULT_STORAGE_NODES=storage-01=localhost:50051,storage-02=localhost:50052,storage-03=localhost:50053

# Storage Policies
VAULT_CHUNK_SIZE=4194304
VAULT_REPLICATION_FACTOR=3
VAULT_WRITE_QUORUM=3
VAULT_READ_QUORUM=1

# AI Copilot & Vercel Deployment
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
LLM_PROVIDER=mistral
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
VAULT_BACKEND_URL=http://localhost:8085
